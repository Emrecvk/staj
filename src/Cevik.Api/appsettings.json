{
  // Bu dosya sürüm kontrolüne girer — GERÇEK PAROLA VE ANAHTAR YAZILMAZ.
  // Yerel değerler appsettings.Development.json içindedir (git tarafından yok sayılır).
  // Kurulum için: appsettings.Development.example.json dosyasını kopyalayın.
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=cevik;Username=cevik;Password=__PAROLA__",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Key": "__JWT_ANAHTARI__",
    "Issuer": "CevikApi",
    "Audience": "CevikWeb",
    "GecerlilikDakika": 120
  },
  "Ticari": {
    "KdvOrani": 20,
    "AnaParaBirimi": "TRY",
    "UcretsizKargoEsigi": 1000,
    "KargoUcreti": 50
  },
  "Cors": {
    // Uretimde bos birakilamaz — uygulama acilista durur.
    // Gelistirmede tanimsizsa http://localhost:3000 varsayilir.
    "IzinliKokenler": [ "https://cevik.com", "https://www.cevik.com", "https://admin.cevik.com" ]
  },
  // Ters proxy (nginx, ALB, Cloudflare) arkasinda calisiliyorsa proxy'nin
  // adresi burada tanimlanmalidir. Aksi halde X-Forwarded-For yok sayilir ve
  // oran sinirlayici tum istekleri proxy'nin tek IP'sinde toplar.
  //
  // GUVENLIK: bu listeyi bos birakip "TumProxylereGuven": true YAZMAYIN.
  // O ayar forwarded basligini her kaynaktan kabul eder ve giris ucundaki
  // oran sinirlamasi sahte bir baslikla sinirsiz kez atlatilabilir hale gelir.
  // Yalnizca gelistirme ve entegrasyon testleri icin vardir.
  "ForwardedHeaders": {
    "GuvenilenProxyler": [],
    "GuvenilenAglar": [],
    "TumProxylereGuven": false
  },
  "Yonetici": {
    "Eposta": "admin@cevik.local",
    "Parola": "__YONETICI_PAROLASI__"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
