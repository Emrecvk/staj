# ÇEVİK Elektronik — ortam değişkenleri şablonu
#
# KURULUM
#   1. Bu dosyayı ".env" adıyla kopyalayın.
#   2. Aşağıdaki değerleri doldurun.
#   3. .env dosyası git tarafından yok sayılır; ASLA commit'lemeyin.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# JWT imza anahtarı
#
# En az 32 karakter olmalıdır (HMAC-SHA256 için 256 bit); daha kısa bir
# değerde uygulama açılışta durur. Rastgele üretmek için:
#   PowerShell : [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
#   bash       : openssl rand -base64 48
# ---------------------------------------------------------------------------
JWT_KEY=

# ---------------------------------------------------------------------------
# Seed ile oluşturulan yönetici hesabı
# Parola boş bırakılırsa yönetici hesabı oluşturulmaz (uygulama yine çalışır).
# ---------------------------------------------------------------------------
YONETICI_EPOSTA=admin@cevik.local
YONETICI_PAROLA=

# ---------------------------------------------------------------------------
# pgAdmin
# ---------------------------------------------------------------------------
PGADMIN_EPOSTA=admin@example.com
PGADMIN_PAROLA=
